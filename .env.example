# Supabase (login / data) — Dashboard → Settings → API
# VITE_SUPABASE_URL = Project URL
# VITE_SUPABASE_ANON_KEY = "anon" "public" key ONLY (not service_role — causes "secret API key in browser")
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini (AI chat, goals, etc.) — also exposed in browser via VITE_*
# Model fixed in src/lib/gemini.js: gemini-2.0-flash
VITE_GEMINI_API_KEY=

# Run: npm run check-env  (validates .env.local without printing secrets)
