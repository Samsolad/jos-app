# Supabase (login / data) — Dashboard → Settings → API
# VITE_SUPABASE_ANON_KEY = "anon" "public" key ONLY (never service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini: set GEMINI_API_KEY as a Supabase secret (see supabase/DEPLOY.md), not here.
# Optional local fallback only if edge function is not deployed:
# VITE_GEMINI_API_KEY=

# Run: npm run check-env