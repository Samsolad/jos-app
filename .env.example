# Supabase (login / data) — Dashboard → Settings → API
# VITE_SUPABASE_ANON_KEY = "anon" "public" key ONLY (never service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini: production — GEMINI_API_KEY as Supabase secret (see supabase/DEPLOY.md).
